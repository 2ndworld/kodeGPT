{
  "name": "kodegpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kodegpt": "bin/kodegpt.mjs"
  },
  "files": [
    "bin/kodegpt.mjs"
  ],
  "scripts": {
    "build:cli": "node scripts/build-cli.mjs",
    "build": "pnpm run build:cli && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "@kodegpt/runtime-linux-x64": "workspace:*"
  },
  "devDependencies": {
    "@kodegpt/artifacts": "workspace:*",
    "@kodegpt/audit": "workspace:*",
    "@kodegpt/auth": "workspace:*",
    "@kodegpt/capabilities": "workspace:*",
    "@kodegpt/core": "workspace:*",
    "@kodegpt/extensions": "workspace:*",
    "@kodegpt/mcp-server": "workspace:*",
    "@kodegpt/profiles": "workspace:*",
    "@kodegpt/skills": "workspace:*",
    "@kodegpt/trust": "workspace:*",
    "esbuild": "0.28.1"
  }
}
