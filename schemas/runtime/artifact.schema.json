{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodegpt.local/schemas/runtime/artifact.schema.json",
  "title": "KodeGPT Runtime Raw Artifact Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "mediaType",
    "bytesWritten",
    "sourceTruncated"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": {
      "type": "string",
      "pattern": "^ka_[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
    "bytesWritten": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "sourceTruncated": { "type": "boolean" }
  }
}
