{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodegpt.local/schemas/runtime/audit.schema.json",
  "title": "KodeGPT Security Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "timestampUnixMs",
    "phase",
    "requestId",
    "operationId",
    "action"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "timestampUnixMs": { "type": "integer", "minimum": 0 },
    "phase": { "enum": ["decision", "outcome"] },
    "requestId": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]+$",
      "maxLength": 96
    },
    "operationId": {
      "type": "string",
      "pattern": "^op_[A-Za-z0-9_-]+$",
      "maxLength": 96
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^kc_[A-Za-z0-9_-]+$",
      "maxLength": 96
    },
    "action": {
      "enum": [
        "inspect_root",
        "workspace_register",
        "workspace_read_project_profile",
        "workspace_restrict_policy",
        "workspace_activate",
        "workspace_begin_close",
        "workspace_cancel_executions",
        "workspace_unregister",
        "file_read",
        "file_tree",
        "file_search",
        "file_write",
        "file_edit",
        "git_status",
        "git_diff",
        "artifact_spool_create",
        "test_effect"
      ]
    },
    "decision": { "const": "allow" },
    "reason": { "enum": ["request_validated", "test_authorized"] },
    "outcome": { "enum": ["success", "failed"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "decision" } },
        "required": ["phase"]
      },
      "then": {
        "required": ["decision", "reason"],
        "properties": { "outcome": false }
      }
    },
    {
      "if": {
        "properties": { "phase": { "const": "outcome" } },
        "required": ["phase"]
      },
      "then": {
        "required": ["outcome"],
        "properties": {
          "decision": false,
          "reason": false
        }
      }
    }
  ]
}
