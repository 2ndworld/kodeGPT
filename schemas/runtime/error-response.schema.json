{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodegpt.local/schemas/runtime/error-response.schema.json",
  "title": "KodeGPT Runtime Error Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "error"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": true
      }
    }
  }
}
