{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodegpt.local/schemas/runtime/request.schema.json",
  "title": "KodeGPT Runtime Request",
  "$defs": {
    "persistentFilesystemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceMajor", "deviceMinor", "inode"],
      "properties": {
        "deviceMajor": { "type": "integer", "minimum": 0 },
        "deviceMinor": { "type": "integer", "minimum": 0 },
        "inode": { "type": "string", "minLength": 1 }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "allowWrite",
        "allowProcess",
        "network",
        "allowedExecutableNames",
        "inheritEnv",
        "envAllowlist"
      ],
      "properties": {
        "name": { "enum": ["observe", "develop", "trusted"] },
        "allowWrite": { "type": "boolean" },
        "allowProcess": { "type": "boolean" },
        "network": { "enum": ["deny", "localhost", "allowlist", "unrestricted"] },
        "allowedExecutableNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inheritEnv": { "const": false },
        "envAllowlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "runtime.hello" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "system.inspect_root" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.register" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rootPath", "expectedIdentity", "ceiling"],
          "properties": {
            "rootPath": { "type": "string", "minLength": 1 },
            "expectedIdentity": { "$ref": "#/$defs/persistentFilesystemIdentity" },
            "ceiling": { "$ref": "#/$defs/runtimePolicy" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.read_project_profile" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.restrict_policy" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "restriction"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "restriction": { "$ref": "#/$defs/runtimePolicy" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.activate" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.begin_close" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.cancel_executions" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.unregister" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.read" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "offset", "maxBytes"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "offset": { "type": "integer", "minimum": 0 },
            "maxBytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.tree" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "maxEntries"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "maxEntries": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.search" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "query"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "query": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.write" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "content"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "content": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.edit" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "oldText", "newText", "expectedReplacements"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "oldText": { "type": "string", "minLength": 1 },
            "newText": { "type": "string" },
            "expectedReplacements": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "git.status" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "git.diff" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "process.run" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "logicalExecutable", "argv", "cwd", "env", "background"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "logicalExecutable": { "type": "string", "minLength": 1 },
            "argv": {
              "type": "array",
              "items": { "type": "string" }
            },
            "cwd": { "type": "string" },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "background": { "type": "boolean" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "process.status" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "operationId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "operationId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "process.cancel" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "operationId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "operationId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "artifact.read" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "offset", "maxBytes"],
          "properties": {
            "artifactId": { "type": "string", "pattern": "^ka_[A-Za-z0-9_-]{1,93}$" },
            "offset": { "type": "integer", "minimum": 0 },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
          }
        }
      }
    }
  ]
}
