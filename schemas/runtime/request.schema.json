{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodegpt.local/schemas/runtime/request.schema.json",
  "title": "KodeGPT Runtime Request",
  "$defs": {
    "persistentFilesystemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceMajor", "deviceMinor", "inode"],
      "properties": {
        "deviceMajor": { "type": "integer", "minimum": 0 },
        "deviceMinor": { "type": "integer", "minimum": 0 },
        "inode": { "type": "string", "minLength": 1 }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "allowWrite",
        "allowProcess",
        "network",
        "allowedExecutableNames",
        "inheritEnv",
        "envAllowlist"
      ],
      "properties": {
        "name": { "enum": ["observe", "develop", "trusted"] },
        "allowWrite": { "type": "boolean" },
        "allowProcess": { "type": "boolean" },
        "network": { "enum": ["deny", "localhost", "allowlist", "unrestricted"] },
        "allowedExecutableNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inheritEnv": { "const": false },
        "envAllowlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gitRevisionSpec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "head" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "oid"],
          "properties": {
            "kind": { "const": "oid" },
            "oid": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "branch" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "tag" },
            "name": { "type": "string" }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "runtime.hello" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "system.inspect_root" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "trust.audit" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "action", "phase"],
          "properties": {
            "operationId": {
              "type": "string",
              "pattern": "^op_[A-Za-z0-9_-]{1,93}$"
            },
            "action": { "enum": ["trust", "profile_update", "untrust"] },
            "phase": { "enum": ["decision", "success", "failed"] }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "ci.audit" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "operationId", "ciCapability", "phase", "provider", "repository"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "operationId": { "type": "string", "pattern": "^op_[A-Za-z0-9_-]{1,93}$" },
            "ciCapability": { "enum": ["ci.repository", "ci.status", "ci.runs", "ci.run", "ci.failure"] },
            "phase": { "enum": ["decision", "success", "failed"] },
            "provider": { "const": "github" },
            "repository": {
              "type": "string",
              "minLength": 3,
              "maxLength": 201,
              "pattern": "^[^/:@\\u0000-\\u001F\\u007F]{1,100}/[^/:@\\u0000-\\u001F\\u007F]{1,100}$"
            },
            "credentialSource": { "const": "gh" },
            "runId": { "type": "string", "pattern": "^[0-9]{1,32}$" },
            "jobId": { "type": "string", "pattern": "^[0-9]{1,32}$" },
            "errorCode": {
              "enum": [
                "CI_WORKSPACE_AMBIGUOUS",
                "CI_AUDIT_UNAVAILABLE",
                "CI_AUTH_REQUIRED",
                "CI_AUTH_FAILED",
                "CI_REPOSITORY_UNAVAILABLE",
                "CI_REPOSITORY_MISMATCH",
                "CI_REMOTE_UNSUPPORTED",
                "CI_NOT_FOUND",
                "CI_PERMISSION_DENIED",
                "CI_RATE_LIMITED",
                "CI_PROVIDER_UNAVAILABLE",
                "CI_RESPONSE_INVALID",
                "CI_RESPONSE_LIMIT_EXCEEDED",
                "CI_LOG_UNAVAILABLE",
                "CI_LOG_LIMIT_EXCEEDED"
              ]
            },
            "truncated": { "type": "boolean" },
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "provider.audit" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "operation", "phase", "providerInstanceId", "adapterId"],
          "properties": {
            "operationId": { "type": "string", "pattern": "^op_[A-Za-z0-9_-]{1,93}$" },
            "operation": { "enum": ["add", "remove", "enable", "disable", "reapprove", "execute", "inventory"] },
            "phase": { "enum": ["decision", "success", "failed"] },
            "providerInstanceId": { "type": "string", "pattern": "^prv_[0-9a-f]{32}$" },
            "adapterId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$" },
            "semanticCapabilityId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$" },
            "errorCode": {
              "enum": [
                "PROVIDER_INPUT_INVALID",
                "PROVIDER_STATE_INVALID",
                "PROVIDER_NOT_ADMITTED",
                "PROVIDER_DISABLED",
                "PROVIDER_IDENTITY_CHANGED",
                "PROVIDER_CREDENTIAL_UNAVAILABLE",
                "PROVIDER_CREDENTIAL_REJECTED",
                "PROVIDER_NETWORK_DENIED",
                "PROVIDER_UNAVAILABLE",
                "PROVIDER_TIMEOUT",
                "PROVIDER_CANCELLED",
                "PROVIDER_RATE_LIMITED",
                "PROVIDER_RESPONSE_INVALID",
                "PROVIDER_OUTPUT_LIMIT_EXCEEDED",
                "PROVIDER_TOOL_UNAVAILABLE",
                "PROVIDER_INVENTORY_CHANGED",
                "PROVIDER_REQUEST_FAILED",
                "PROVIDER_AUDIT_UNAVAILABLE"
              ]
            },
            "inventoryChanged": { "type": "boolean" },
            "truncated": { "type": "boolean" },
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.register" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rootPath", "expectedIdentity", "ceiling"],
          "properties": {
            "rootPath": { "type": "string", "minLength": 1 },
            "expectedIdentity": { "$ref": "#/$defs/persistentFilesystemIdentity" },
            "ceiling": { "$ref": "#/$defs/runtimePolicy" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.read_project_profile" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.restrict_policy" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "restriction"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "restriction": { "$ref": "#/$defs/runtimePolicy" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.activate" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.begin_close" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.cancel_executions" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "workspace.unregister" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.read" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "offset", "maxBytes"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "offset": { "type": "integer", "minimum": 0 },
            "maxBytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.tree" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "maxEntries", "scope"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "maxEntries": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "scope": { "enum": ["literal", "semantic"] }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.search" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "query", "maxMatches", "scope"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "query": { "type": "string", "minLength": 1 },
            "maxMatches": { "type": "integer", "minimum": 1, "maximum": 500 },
            "scope": { "enum": ["literal", "semantic"] }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.identity" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "includeSha256"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "includeSha256": { "type": "boolean" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.write" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "content"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "content": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.edit" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "oldText", "newText", "expectedReplacements"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "oldText": { "type": "string", "minLength": 1 },
            "newText": { "type": "string" },
            "expectedReplacements": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "file.commit_patch_file" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId", "path", "action", "expectedSha256", "content"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "action": { "enum": ["create", "update", "delete"] },
            "expectedSha256": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              ]
            },
            "content": { "type": ["string", "null"] }
          },
          "oneOf": [
            {
              "properties": {
                "action": { "const": "create" },
                "expectedSha256": { "type": "null" },
                "content": { "type": "string" }
              }
            },
            {
              "properties": {
                "action": { "const": "update" },
                "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "content": { "type": "string" }
              }
            },
            {
              "properties": {
                "action": { "const": "delete" },
                "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "content": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "git.repository_identity" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "git.status" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "git.checkpoint" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "git.checkpoint_patch" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "git.diff" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityId"],
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "git.local_mutation" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capabilityId": { "type": "string", "minLength": 1 },
            "operation": {
              "enum": ["stage", "commit", "branch_create", "branch_switch", "branch_delete"]
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "name": { "type": "string", "minLength": 1, "maxLength": 255 }
          },
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "operation", "paths"],
              "properties": {
                "capabilityId": { "type": "string", "minLength": 1 },
                "operation": { "const": "stage" },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "operation", "message"],
              "properties": {
                "capabilityId": { "type": "string", "minLength": 1 },
                "operation": { "const": "commit" },
                "message": { "type": "string", "minLength": 1, "maxLength": 4096 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "operation", "name"],
              "properties": {
                "capabilityId": { "type": "string", "minLength": 1 },
                "operation": { "const": "branch_create" },
                "name": { "type": "string", "minLength": 1, "maxLength": 255 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "operation", "name"],
              "properties": {
                "capabilityId": { "type": "string", "minLength": 1 },
                "operation": { "const": "branch_switch" },
                "name": { "type": "string", "minLength": 1, "maxLength": 255 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "operation", "name"],
              "properties": {
                "capabilityId": { "type": "string", "minLength": 1 },
                "operation": { "const": "branch_delete" },
                "name": { "type": "string", "minLength": 1, "maxLength": 255 }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
